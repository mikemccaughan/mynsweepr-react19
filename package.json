    "preview": "yarn dlx vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/binding-wasm32-wasi": "^1.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/source-map-support": "^0",
    "@vitejs/devtools": "^0.8.2",
    "@vitejs/devtools-oxc": "^0.8.2",
    "@vitejs/devtools-rolldown": "^0.8.2",
    "@vitejs/devtools-vite": "^0.8.2",
    "@vitejs/devtools-vitest": "^0.8.2",
    "@vitejs/plugin-react": "^6.3.0",
    "browserslist": "^4.29.5",
    "esbuild": "^0.28.2",
